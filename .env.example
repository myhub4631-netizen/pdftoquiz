# =========================================================================
# QUESTIONFORGE AI: ENVIRONMENT VARIABLES CONFIGURATION
# =========================================================================

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Database & Storage Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Secret key used for server-side AES-256-GCM encryption of OpenRouter API credentials
ENCRYPTION_SECRET=replace-with-a-secure-random-32-byte-hex-string-for-production

# OpenRouter AI Credentials (Default fallback if not configured in Master Admin UI)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
